# --- Google (Gmail) ---
# Google Cloud project -> enable Gmail API -> OAuth Desktop client
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# Refresh token: run `npm run auth:google` (writes .tokens/google-token.json),
# or paste it here to use env instead of the token file.
# GOOGLE_REFRESH_TOKEN=

# --- Slack ---
# Slack app -> OAuth & Permissions -> Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...

# Optional: default channel for summaries when the tool gets no channel
# (channel id like C0123456789, or name like #inbox-brief)
SLACK_DEFAULT_CHANNEL=
