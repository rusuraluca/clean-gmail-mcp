# --- Google (Gmail + Calendar) ---
# Google Cloud project -> enable Gmail API + Calendar API -> OAuth Desktop client
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# Refresh token: run `npm run auth:google` (writes .tokens/google-token.json),
# or paste it here to use env instead of the token file.
# GOOGLE_REFRESH_TOKEN=

# Timezone used to decide "today" for calendar_fetch_today
# CALENDAR_TIMEZONE=Europe/London

# --- Slack ---
# Slack app -> OAuth & Permissions -> Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...

# Optional: default channel for summaries when the tool gets no channel
# (channel id like C0123456789, or name like #inbox-brief)
SLACK_DEFAULT_CHANNEL=

# --- Slack listener (OpenWork bridge, `npm run start:slack`) ---
# Slack app -> Socket Mode -> enable, then generate an app-level token (xapp-...)
SLACK_SOCKET_TOKEN=xapp-...

# Your Slack user id — only this user can drive the bridge (required)
SLACK_ALLOWED_USER=U0123456789

# OpenWork Connect gateway (defaults shown)
# OPENWORK_GATEWAY_URL=https://api.openworklabs.com/mcp/agent
# OPENWORK_OAUTH_PORT=34567

# Where remote sessions run: "cloud" (needs OpenWork Web subscription) or
# "desktop" (runs in your signed-in OpenWork Desktop; must be open)
# OPENWORK_SESSION_TARGET=cloud
